<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista -->
        <record id="estate_property_offer_list" model="ir.ui.view">
            <field name="name">estate.property.offer.list</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="Lista de ofertas">
                    <field name="price" />
                    <field name="partner_id" />
                    <field name="status" />
                    <field name="validity" />
                    <field name="date_deadline" />
                    <button name="action_accept_offer" type="object" icon="fa-check" title="Aceptar oferta" />
                </list>
            </field>
        </record>

        <!-- Acción de ventana -->
        <record id="estate_property_offer_action" model="ir.actions.act_window">
            <field name="name">Ofertas de propiedades</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>